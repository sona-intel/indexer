# Secrets: never commit real keys. Copy .env.example to .env instead.
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output (from Envio's HyperIndex template).
# .envio/ is not listed: Envio commits its own .envio/.gitignore.
node_modules/
.pnpm-store/
build/
logs/
artifacts/
cache/
benchmarks/
*.res.js
*.res.mjs
*.log

# OS and editor files
.DS_Store
.idea/
.vscode/
